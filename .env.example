# Copy to backend/.env for local dev (never commit .env).
# Leave DATABASE_URL unset to use SQLite at backend/data/validex.db.
# DATABASE_URL=postgresql+psycopg2://validex:validex@localhost:5432/validex
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# Optional AI features via Groq (https://console.groq.com/keys). Both OFF by default.
# For Docker: put these in a file named .env in the repo root (next to docker-compose.yml).
# For local dev: put them in backend/.env.
# GROQ_API_KEY=gsk_...
# AI_FALLBACK_ENABLED=true      # AI reader for poor scans (values need officer confirmation)
# LLM_SUMMARY_ENABLED=true      # case summary that cites finding ids
# VISION_MODEL=qwen/qwen3.8-27b
# SUMMARY_MODEL=openai/gpt-oss-120b
